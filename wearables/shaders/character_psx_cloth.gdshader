// Materiale dei capi indossati: DUE facce, cosi' attraverso polsini, colletti e orli si vede
// l'interno del capo (scurito) invece del vuoto. Il codice e' in character_psx.gdshaderinc.
shader_type spatial;
render_mode diffuse_lambert, specular_disabled, cull_disabled;

#include "res://wearables/shaders/character_psx.gdshaderinc"
