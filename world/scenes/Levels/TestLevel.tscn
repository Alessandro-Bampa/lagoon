; Rientro di chi finisce in acqua: sul molo, y = 1.25 + mezza capsula.
[node name="ShoreRespawn" type="Marker3D" parent="Lagoon" groups=["water_respawn"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 2.25, 0)

; Barca STATICA nel livello, non spawnata a runtime: il NodePath e' identico su ogni peer, quindi il
; MultiplayerSynchronizer interno funziona senza passare da un MultiplayerSpawner (stesso criterio di
; TargetDummy). y=0.2 e' anche la quota di riposo del galleggiamento, quindi non c'e' assestamento.
[node name="Boat" parent="." instance=ExtResource("3")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 31, 0.2, 0)

