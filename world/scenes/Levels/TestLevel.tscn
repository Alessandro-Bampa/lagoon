; --- Laguna (Fase 4) -----------------------------------------------------------------------------
; Il Floor esistente (x,z in [-20,20], superficie y=0) NON e' stato toccato: la laguna e' adiacente
; in +X. Quote scelte perche' non ci sia nessuno scalino da superare a piedi: molo e ponte della barca
; sono COMPLANARI a y=1.25, collegati da una passerella che li sovrappone; da terra si sale con una
; rampa inclinata (CharacterBody3D in Godot 4 non ha step-up automatico).
[node name="Lagoon" type="Node3D" parent="."]

[node name="Seabed" type="StaticBody3D" parent="Lagoon"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 50, -4.5, 0)
collision_layer = 1
collision_mask = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="Lagoon/Seabed"]
shape = SubResource("Shape_Seabed")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Lagoon/Seabed"]
mesh = SubResource("Mesh_Seabed")
material_override = SubResource("Mat_Sand")

[node name="Dock" type="StaticBody3D" parent="Lagoon"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22.5, -0.25, 0)
collision_layer = 1
collision_mask = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="Lagoon/Dock"]
shape = SubResource("Shape_Dock")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Lagoon/Dock"]
mesh = SubResource("Mesh_Dock")
material_override = SubResource("Mat_Wood")

; Rampa terra -> molo: 20 gradi, sotto il floor_max_angle di 45.
; Il piede e' INTERRATO sotto il pavimento (la faccia superiore attraversa y=0 a x=14): un
; CharacterBody3D in Godot 4 non ha step-up automatico, quindi anche una soglia di pochi centimetri si
; comporterebbe come un muro. La rampa deve emergere dal pavimento come un cuneo, senza spigoli.
[node name="Ramp" type="StaticBody3D" parent="Lagoon"]
transform = Transform3D(0.9397, -0.342, 0, 0.342, 0.9397, 0, 0, 0, 1, 16.385, 0.437, 0)
collision_layer = 1
collision_mask = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="Lagoon/Ramp"]
shape = SubResource("Shape_Ramp")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Lagoon/Ramp"]
mesh = SubResource("Mesh_Ramp")
material_override = SubResource("Mat_Wood")

; Passerella molo -> ponte: complanare a entrambi (superficie y=1.25), sovrapposta al molo per 1 m e al
; ponte per 0.3 m, cosi' l'imbarco regge anche se la barca deriva un poco all'ormeggio. Passa 0.35 m
; sopra il tetto dello scafo (y=0.8), quindi non lo urta; arriva sul varco del parapetto di sinistra.
[node name="Plank" type="StaticBody3D" parent="Lagoon"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 27.75, 1.2, 0)
collision_layer = 1
collision_mask = 1

[node name="CollisionShape3D" type="CollisionShape3D" parent="Lagoon/Plank"]
shape = SubResource("Shape_Plank")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Lagoon/Plank"]
mesh = SubResource("Mesh_Plank")
material_override = SubResource("Mat_Wood")

; Superficie d'acqua: SOLO mesh, nessun corpo fisico (vedi WaterVolume.cs).
[node name="WaterSurface" type="MeshInstance3D" parent="Lagoon"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 50, 0, 0)
mesh = SubResource("Mesh_Water")
material_override = SubResource("Mat_Water")

[node name="WaterVolume" type="Node3D" parent="Lagoon"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 50, 0, 0)
script = ExtResource("2")
