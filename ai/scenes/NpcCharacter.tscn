[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://ai/scripts/NpcController.cs" id="1"]
[ext_resource type="PackedScene" path="res://animation/scenes/CharacterRig.tscn" id="2"]
[ext_resource type="Script" path="res://ai/scripts/NpcAnimationBridge.cs" id="3"]
[ext_resource type="Script" path="res://combat/scripts/HealthComponent.cs" id="4"]
[ext_resource type="Script" path="res://combat/scripts/HitboxComponent.cs" id="5"]
[ext_resource type="Script" path="res://vision/scripts/VisibilityGate.cs" id="6"]

[sub_resource type="CapsuleShape3D" id="Shape_Body"]
radius = 0.5
height = 2.0

; Stesse proprieta' replicate del giocatore, meno SyncAnchorId: un NPC non sale in barca.
; SyncAimPitch, SyncAimYaw e SyncAiming ci sono gia' perche' quando gli NPC saranno armati
; servono subito, e aggiungerli dopo vorrebbe dire ritoccare la scena invece che solo il codice.
[sub_resource type="SceneReplicationConfig" id="Repl_Npc"]
properties/0/path = NodePath(".:SyncPosition")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:SyncFacing")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:SyncLocalVelocity")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:SyncCrouching")
properties/3/spawn = true
properties/3/replication_mode = 1
properties/4/path = NodePath(".:SyncGrounded")
properties/4/spawn = true
properties/4/replication_mode = 1
properties/5/path = NodePath(".:SyncAimPitch")
properties/5/spawn = true
properties/5/replication_mode = 1
properties/6/path = NodePath(".:SyncAimYaw")
properties/6/spawn = true
properties/6/replication_mode = 1
properties/7/path = NodePath(".:SyncAiming")
properties/7/spawn = true
properties/7/replication_mode = 1

[sub_resource type="SceneReplicationConfig" id="Repl_Health"]
properties/0/path = NodePath(".:CurrentHealth")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:MaxHealth")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:IsDead")
properties/2/spawn = true
properties/2/replication_mode = 1

; NPC umano: stesso corpo, stesso rig e stesse animazioni del giocatore.
; collision_layer 4 = "enemies", collision_mask 1 = solo il mondo statico.
[node name="NpcCharacter" type="CharacterBody3D"]
collision_layer = 4
collision_mask = 1
script = ExtResource("1")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("Shape_Body")

; L'unico nodo che ruota, come nel Player: il corpo resta fermo.
[node name="Visual" type="Node3D" parent="."]

; Il rig ha l'origine ai PIEDI, la capsula e' centrata: da qui lo scostamento di un metro.
[node name="CharacterRig" parent="Visual" instance=ExtResource("2")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1, 0)

[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
path_desired_distance = 0.5
target_desired_distance = 0.5

[node name="Synchronizer" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_config = SubResource("Repl_Npc")

[node name="Health" type="Node" parent="."]
script = ExtResource("4")

[node name="Sync" type="MultiplayerSynchronizer" parent="Health"]
root_path = NodePath("..")
replication_config = SubResource("Repl_Health")

[node name="Hitbox" type="Area3D" parent="."]
collision_layer = 8
collision_mask = 0
monitoring = false
script = ExtResource("5")
HealthPath = NodePath("../Health")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Hitbox"]
shape = SubResource("Shape_Body")

[node name="AnimationBridge" type="Node" parent="."]
script = ExtResource("3")

; Occultamento locale: nasconde il nodo Visual quando l'avatar del giocatore locale non vede
; questo personaggio. NON tocca la hitbox — vedi il commento in VisibilityGate.
[node name="VisibilityGate" type="Node" parent="."]
script = ExtResource("6")
