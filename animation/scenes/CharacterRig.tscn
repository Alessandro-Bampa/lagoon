[gd_scene load_steps=8 format=3]

[ext_resource type="PackedScene" path="res://assets/models/Body_Base.glb" id="1"]
[ext_resource type="AnimationLibrary" path="res://assets/models/animations/CharacterAnimations.glb" id="2"]
[ext_resource type="AnimationNodeBlendTree" path="res://animation/resources/CharacterBlendTree.tres" id="3"]
[ext_resource type="Script" path="res://animation/scripts/CharacterAnimator.cs" id="4"]
[ext_resource type="Script" path="res://animation/scripts/WeaponGripRig.cs" id="5"]
[ext_resource type="Script" path="res://animation/scripts/AimRig.cs" id="6"]
[ext_resource type="Script" path="res://animation/scripts/FootIkRig.cs" id="7"]

; Rig del personaggio, condiviso da player e (in futuro) NPC: nessun riferimento a
; PlayerController qui dentro, il pilotaggio arriva dall'esterno via CharacterAnimator.
[node name="CharacterRig" type="Node3D"]
script = ExtResource("4")

[node name="Body" parent="." instance=ExtResource("1")]

; AnimationTree senza AnimationPlayer: da Godot 4.2 l'AnimationTree e' un AnimationMixer
; e puo' tenere le librerie direttamente, quindi un AnimationPlayer intermedio sarebbe
; solo un nodo in piu' da tenere allineato.
;
; root_node DEVE puntare al nodo istanziato dal .glb: i path delle track sono
; "Armature_Character/Skeleton3D:<Bone>", relativi a quella radice. Puntandolo altrove
; le track non risolvono e l'animazione non si vede, senza alcun errore a runtime.
[node name="AnimationTree" type="AnimationTree" parent="."]
root_node = NodePath("../Body")
tree_root = ExtResource("3")
libraries = {
&"": ExtResource("2")
}
active = true

; Aggancio dell'arma alla mano destra. Crea da codice il BoneAttachment3D e l'IK della
; mano di supporto: sono figli dello Skeleton3D, che vive dentro Body_Base.glb e si
; rigenera, quindi metterli qui nella scena li esporrebbe a sparire a ogni reimport.
[node name="GripRig" type="Node3D" parent="."]
script = ExtResource("5")

; Mira procedurale: corregge il busto perche' l'arma punti dove punta il cursore, qualunque
; cosa stia facendo la clip di locomozione al bacino. E' il layer che rende leggibile il
; movimento armato, e l'unico posto da cui passa l'inclinazione verticale della mira.
[node name="AimRig" type="Node3D" parent="."]
script = ExtResource("6")

; Piedi a terra: ogni piede cerca il suolo col proprio raggio e l'IK ce lo porta, col bacino
; che scende quanto basta. E' la parte che reagisce al TERRENO — rampe, scalini, il ponte
; inclinato di una barca — dove le clip metterebbero i piedi tutti alla stessa quota.
[node name="FootIkRig" type="Node3D" parent="."]
script = ExtResource("7")
