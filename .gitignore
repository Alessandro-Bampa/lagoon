# Godot 4+ specific ignores
.godot/
/android/

# .NET / C#
.mono/
bin/
obj/
*.csproj.user

# Godot export output
/export/
export_presets.cfg

# Steam: l'AppID puo' differire tra dev e produzione (vedi la skill steam-networking)
steam_appid.txt

# Copie temporanee create da Godot durante l'hot-reload delle librerie native
addons/**/~*

# Cache Python degli script Blender (tools/blender/)
__pycache__/
*.pyc

demo/*

# Mappe di gioco: i dati generati non si versionano, si rigenerano con la pipeline
# di addons/venice_builder/tools (skill venice-terrain). In git: map.json, scena, script.
world/maps/*/osm/
world/maps/*/terrain/
world/maps/*/classes/
world/maps/*/build/
world/maps/*/far/
world/maps/*/water/

# log della pipeline
world/maps/*/*.log
