; Spazio sopra la testa: impedisce di rialzarsi da accovacciati sotto un ostacolo basso, che
; incastrerebbe la capsula dentro il soffitto. Maschera: solo il mondo statico (layer 1) e i veicoli.
[node name="Headroom" type="ShapeCast3D" parent="."]
shape = SubResource("Shape_Headroom")
target_position = Vector3(0, 0.8, 0)
collision_mask = 33

[node name="Visual" type="Node3D" parent="."]

; Il rig ha l'origine ai PIEDI (vedi skill blender-pipeline), la capsula del
; CharacterBody3D ha l'origine al CENTRO: senza questo offset il personaggio
; sprofonderebbe di mezza altezza nel pavimento.
[node name="CharacterRig" parent="Visual" instance=ExtResource("13")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1, 0)

